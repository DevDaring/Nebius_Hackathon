# NemoTwins configuration. Copy to `.env` (never commit `.env`) and fill in what you have.
# Placeholders only. With an empty TOKENFACTORY_2009_API_KEY the app runs offline (APP_MODE=demo):
# deterministic templates answer, and the numerical twin engine always runs for real.
# Competition: https://nebiusglobalaihackathon.devpost.com/

# --- User-required names. Keep the exact spelling (NEBUIS is intentional). ---
TOKENFACTORY_2009_API_KEY=
NEBUIS_CLOUD_API_KEY=

# --- Inference: Nebius Token Factory is the ONLY model provider. ---
# Model ids verified with GET /v1/models on 2026-10-08 (see backend/capabilities/manifest.json).
TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_CHAT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_COMPLEX_MODEL=nvidia/nemotron-3-super-120b-a12b
# No NVIDIA vision model on Token Factory: a non-NVIDIA Token Factory model suggests dish candidates only.
NEMOTRON_VISION_MODEL=google/gemma-3-27b-it
# Not used: food lookup is a deterministic table match (no retrieval).
NEMOTRON_EMBED_MODEL=
AI_PROVIDER=nebius_tokenfactory
# Planner/explainer model: complex (Nemotron 3 Super, default) or chat (Nemotron 3 Nano). Thinking off = ~1 s/call.
NEMOTRON_PLANNER_MODEL=complex
NEMOTRON_PLANNER_THINKING=false
# live = Token Factory calls; demo = offline templates. Unset: live when a Token Factory key is present.
APP_MODE=
VISION_ENABLED=true
# Further reading for education / evidence questions: Tavily web-search API (not a model; no generated
# answers). Only a fixed topic query is sent; results restricted to allowlisted health sites.
TAVILY_API_KEY=
REFERENCES_ENABLED=true

# --- Nebius AI Cloud (deployment / evaluation admin only; never reaches agent tools). ---
# iam_token: NEBUIS_CLOUD_API_KEY holds an IAM access token (`nebius iam get-access-token`; short-lived).
# service_account: use the service-account fields below; NEBUIS_CLOUD_API_KEY is then ignored.
NEBIUS_CLOUD_AUTH_MODE=iam_token
NEBIUS_PROJECT_ID=
NEBIUS_REGION=
NEBIUS_SERVICE_ACCOUNT_ID=
NEBIUS_PUBLIC_KEY_ID=
NEBIUS_PRIVATE_KEY_FILE=
NEBIUS_CREDENTIALS_FILE=
NEBIUS_SERVERLESS_ENDPOINT_ID=
NEBIUS_EVALUATION_JOB_TEMPLATE=
NEBIUS_OBJECT_STORAGE_ENDPOINT=
NEBIUS_OBJECT_STORAGE_BUCKET=
# S3-compatible access key pair for Object Storage (created separately; an IAM token is NOT an S3 secret).
NEBIUS_OBJECT_STORAGE_ACCESS_KEY_ID=
NEBIUS_OBJECT_STORAGE_SECRET_ACCESS_KEY=

# --- App settings ---
APP_NAME=NemoTwins
APP_DEFAULT_LOCALE=en-US
APP_SUPPORTED_LOCALES=en-US,es-ES,fr-FR,de-DE,it-IT,ja-JP
APP_PUBLIC_URL=
APP_ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Synthetic personas only (there is no real-patient mode in this prototype).
DEMO_MODE=true
NEMO_GUARDRAILS_ENABLED=true
NEMO_FISH_ENABLED=true
# Store raw chat text in the audit log (default false: only tool calls, checks, length + hash).
AUDIT_STORE_TEXT=false
# Speech is unavailable: Token Factory has no speech model. Keep false.
NVIDIA_SPEECH_ENABLED=false
NVIDIA_SPEECH_ENDPOINT=
NVIDIA_SPEECH_AUTH_MODE=

# Database (PostgreSQL). Local default shown; docker compose overrides it.
DATABASE_URL=postgresql+psycopg://nemotwins:nemotwins@localhost:5432/nemotwins

# Auth. Set JWT_SECRET to a long random string for any shared deployment
# (`python -c "import secrets; print(secrets.token_urlsafe(48))"`). Leave both commented out to use the
# development defaults (an EMPTY value would mean "no demo accounts").
# JWT_SECRET=
# DEMO_USERS=TestUser:TestUser11
# One-click private demo sessions (POST /api/auth/demo): a throw-away user per visitor.
# DEMO_SESSIONS=true
# DEMO_SESSION_TTL_HOURS=24
# RATE_DEMO_SESSION_PER_HOUR=6
# DEMO_SESSIONS_PER_DAY=500
# Usernames that also get the developer "admin" role (integration page). Empty = nobody.
ADMIN_USERS=

# --- Deliberate operational bounds (not unlimited defaults) ---
LLM_MAX_TOOL_STEPS=6
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENT_REQUESTS=4
# Local guard rail, not a billing cap (Token Factory metering is authoritative). 0 = no local quota.
DAILY_INFERENCE_TOKEN_LIMIT=2000000
EVAL_MAX_CASES_PER_JOB=100
MONTHLY_CLOUD_BUDGET_USD=
DAILY_INFERENCE_BUDGET_USD=
RATE_CHAT_PER_MIN=30
RATE_MEAL_PHOTO_PER_MIN=8

# Frontend (Vite): 1 = run the UI on the built-in mock layer (no backend).
VITE_MOCK=0
VITE_API_TARGET=http://localhost:8000

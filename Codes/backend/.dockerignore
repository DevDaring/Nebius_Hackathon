# Keep the API image small and secret-free. Only code, small artefacts, reports,
# fixtures and the Indian food table go in.
.env
*.env
.env.*
.venv/
**/__pycache__/
**/*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
data/raw/
data/processed/
data/cache/
data/food/raw/
*.log
Dockerfile
.dockerignore

# NemoTwins production settings (copy to the install directory as .env, chmod 600). Never commit real values.
APP_MODE=live
APP_ENVIRONMENT=selfhost
APP_PUBLIC_URL=https://nemotwins.koushikdeb.com
CORS_ORIGINS=https://nemotwins.koushikdeb.com
TOKENFACTORY_2009_API_KEY=
TAVILY_API_KEY=
JWT_SECRET=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nemotwins_prod
# Public demo account shown on the login page; ADMIN_USERS empty keeps the integration page private.
DEMO_USERS=TestUser:TestUser11
ADMIN_USERS=
# "Start a private demo": a throw-away user per visitor (expires after the TTL, data purged with it).
DEMO_SESSIONS=true
DEMO_SESSION_TTL_HOURS=24
RATE_DEMO_SESSION_PER_HOUR=6
DEMO_SESSIONS_PER_DAY=500
NEMO_GUARDRAILS_ENABLED=true
RATE_CHAT_PER_MIN=20
LLM_MAX_CONCURRENT_REQUESTS=4
DAILY_INFERENCE_TOKEN_LIMIT=2000000
AUDIT_STORE_TEXT=false
